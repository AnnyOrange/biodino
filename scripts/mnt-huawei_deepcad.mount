[Unit]
Description=Huawei shared checkpoint storage for approved 20TB resume
Wants=network-online.target
After=network-online.target

[Mount]
What=172.16.1.104:/deepcad
Where=/mnt/huawei_deepcad
Type=nfs
Options=vers=3,rw,hard,nolock,proto=tcp,rsize=1048576,wsize=1048576,_netdev
TimeoutSec=300

[Install]
WantedBy=multi-user.target
