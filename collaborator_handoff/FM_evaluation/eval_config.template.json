  "statistics": {
    "bootstrap_replicates": 2000,
    "permutation_replicates": 10000,
    "random_seed": 20261021,
    "confidence_level": 0.95,
    "resampling": "paired independent groups; strata by source for OOD; keep all patches and all seeds together",
    "seed_aggregation": "mean of per-seed metric, never ensemble predictions",
    "primary_comparisons": "Each fixed configured BioDINO anchor versus each configured FM within matched task/dataset/budget/fold/metric; retrospective checkpoint selection provenance retained",
    "primary_metrics": {
      "ood": "auroc",
      "classification": "balanced_accuracy",
      "regression": "mae",
      "segmentation": "mDice",
      "detection_proxy": "test_patch_f1",
      "cell_tracking": "TRA"
    },
    "multiplicity": "Holm within each dataset/task across the complete predeclared biodino-vs-FM family; pending tests remain pending",
    "checkpoint_selection": "historical retrospective anchors, inference conditional on given weights; no confirmatory claim for datasets used in selection",
    "ood_groups": {
      "xray": "biological sample_id, preserving volumes/variants/slices",
      "cryo": "project_id (4 groups); limited source diversity",
      "id": "BBBC048 source field prefix; CyclOps source image stem; BloodMNIST image ID (donor mapping unavailable)"
    },
    "dense_definition": "Mean of 5 single-seed patch F1 scores; bootstrap original images together across seeds; paired swap all predictions for each image",
    "global_definition": "Deterministic v4 solves; source-group bootstrap and paired source-group swaps; BBBC013 stratified by compound and grouped by replicate row",
    "classification_bootstrap": "Class-stratified source-group bootstrap when each independent source group has homogeneous labels; preserve rare classes; record per-class group counts",
    "segmentation_definition": "Mean of five single-seed pooled-pixel class-macro Dice scores; group bootstrap synchronised across seeds; MoNuSeg TCGA patient groups, Cellpose original image groups with unavailable donor metadata explicitly noted",
    "native_box_definition": "Mean of five independently trained seed APs; source-image groups (patient mapping unavailable); resample same groups across seeds, rerank all detections and recompute COCO101point AP from validated per-image matches; paired group swap synchronizes all five fits; AP50:95 all configured BioDINO anchors x18 Holm family per dataset, AP50/AP75 secondary separate families",
    "retrieval_definition": "Source-query-group bootstrap and paired model swap of Recall@1 outcomes, conditional on fixed gallery; original image hashes available, patient map unavailable; not patient-level inference",
    "clustering_definition": "Mean five single-fit NMI values; source-image group bootstrap synchronized across fitted partitions; recompute NMI from contingency counts. Cluster IDs arbitrary; do not use raw-ID swaps for paired test. Higher-level patient grouping unresolved.",
    "nucls_definition": "Patient bootstrap stratified by official fold; five individual fitted-head metrics then equal-weight mean of folds2-5; synchronized patient swaps; separate seed SD. See nucls_statistics_config.json.",
    "planned_comparisons_per_family": 342,
    "ctc_definition": "Released labelled held-out sequence02; whole CTC domain is one resampling/swap block, including all frames/tracks and all five separately trained seeds. Fold-specific4-domain and complete5-fold20-domain macro metrics. Domain bootstrap stratified by fixed fold; two-sided exact swaps for <=16 domains, otherwise10000 MonteCarlo swaps with plus-one correction. Separate342-comparison Holm families per metric/fold; no official hidden-test claim.",
    "primary_dataset_metrics": {
      "chestmnist": "macro_auc",
      "xray_chest": "rsna_mean_precision",
      "xray_bone": "mae",
      "bbbc038-official": "dsb_mean_precision"
    },
    "multilabel_definition": "Whole recorded-group bootstrap synchronized across all labels/models; macro ROC AUC; paired whole-group score swaps with exact AUC-difference algebra;2000bootstrap/10000permutations; donor linkage unavailable for ChestMNIST, image-conditional inference explicitly reported.",
    "bone_age_definition": "Fixed float64 Ridge,1425released official validation cases; grouped recorded-case percentile bootstrap and paired whole-case prediction swaps; primary MAE months; repeated-patient linkage unavailable, no patient-independence certification.",
    "rsna_definition": "Official3000test exams,2356NIHpatients; all exams and five fitted-head outputs stay within patient block. Bootstrap mean of five individual scored-image mean precisions; negative/no-prediction exclusions follow each fitted model. Paired swaps synchronized across five fits, retaining per-fit scored counts; no ensemble. Primary rsna_mean_precision.",
    "clustering_test_replicates": 10000,
    "clustering_paired_method": "Two-sided centered paired whole-source-image-group bootstrap test, conditional on five fitted partitions. Shared bootstrap draws,2000 percentile CI draws,10000 centered null draws,plus-one p correction. No cluster-ID swaps. Exploratory source-image inference where patient/slide metadata unavailable."
  },
